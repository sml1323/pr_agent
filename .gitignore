# 시크릿 — 절대 커밋 금지
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# 도구 캐시
.pytest_cache/
.ruff_cache/
.mypy_cache/

# OS
.DS_Store

# 참고서 PDF (19MB) — 레포에 넣을 거면 이 줄 지우기
reference_books/

# 영상 자막 원문 — 남의 저작물이라 공개 레포에 올리지 않는다.
# 로컬에는 그대로 남아 검색해 쓸 수 있다.
# 우리가 만든 요약(docs/01-chapter-map.md)과 구조화 추출본(segment_map.json)은 커밋한다.
docs/source/transcript.txt
docs/source/transcript.en.json3

# 구조화 추출본(252K) — 원문 인용은 없지만 촘촘해서 원본의 대체재에
# 가까워질 수 있다. 설계 근거는 docs/*.md 안의 타임스탬프 인용으로 충분하다.
docs/source/segment_map.json

# 챕터 맵 — 영상 전 구간을 타임스탬프별로 매핑한 우리 요약(50K).
# 우리 글이지만 촘촘해서 원본을 대신할 소지가 있어 공개 레포에서는 뺀다.
# 로컬에는 남아 설계 근거를 되짚는 데 계속 쓰인다.
docs/01-chapter-map.md

# 파이썬 캐시
__pycache__/
*.pyc

# 머신별 Claude Code 설정 (권한 허용 목록 등) — 스킬은 커밋한다
.claude/settings.local.json

# 체크포인터가 만드는 sqlite 파일 (M5-6). 리뷰 진행 상태라 레포에 남을 물건이 아니다 —
# 원격이 public 이고, 커밋되면 어느 PR 을 어디까지 리뷰했는지가 그대로 박힌다.
# 지워도 안전하다: 다음 실행 때 다시 만들어진다 (진행 중이던 리뷰만 처음부터 돈다).
*.sqlite
